# Port for the Colyseus server
PORT=2567

# Set to true to enable /monitor and the playground (local development only)
# Off when unset, and always off when NODE_ENV=production. Never set it in production
ENABLE_DEV_TOOLS=true

# TLS certificate for serving HTTPS/WSS (see README "Create a local HTTPS certificate")
# Required: the server won't start without it, except on Colyseus Cloud (which terminates TLS
# itself, so leave these unset there) and in tests
# Paths are relative to the server folder
SSL_KEY_FILE=../certs/dev-key.pem
SSL_CERT_FILE=../certs/dev-cert.pem

# Origins allowed to use the server from a browser (CORS and WebSocket connections), comma-separated
# Required: the server won't start without it. Locally: the client, plus the server itself for the
# playground. In production: the client's real origin
ALLOWED_ORIGINS=https://www.multiversekiln-dev.com:5173,https://www.multiversekiln-dev.com:2567

# Postgres connection for the game server, as kiln_app (can read and write rows, can't alter tables)
# Locally: the Docker database, with KILN_APP_PASSWORD from the root .env. In production: Neon's pooled connection string
DATABASE_URL=postgres://kiln_app:replace-me@127.0.0.1:5432/kiln

# Postgres connection for npm run db:migrate, as kiln_migrator (owns the tables)
# Locally: KILN_MIGRATOR_PASSWORD from the root .env. Only migrations use it; never give it to the running server
MIGRATION_DATABASE_URL=postgres://kiln_migrator:replace-me@127.0.0.1:5432/kiln

# The same two connections for the test suite's database (npm test), which it empties before every test
# The database name must end in _test, or the tests refuse to run
TEST_DATABASE_URL=postgres://kiln_app:replace-me@127.0.0.1:5432/kiln_test
TEST_MIGRATION_DATABASE_URL=postgres://kiln_migrator:replace-me@127.0.0.1:5432/kiln_test

# Server URL that npm run loadtest connects to (must match the certificate's hostname)
LOADTEST_ENDPOINT=wss://www.multiversekiln-dev.com:2567
