# Secret keys below (AUTH_HMAC_KEY, TOTP_ENCRYPTION_KEY, etc) are 32 random bytes in base64. Make one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Make a separate key for each setting, and never commit a secret to your repository

# Port for the Colyseus server
PORT=2567

# Set to true to enable /monitor, the playground and the load test's bot login (local development only)
# Off when unset, and always off when NODE_ENV=production. Never set it in production
ENABLE_DEV_TOOLS=true

# TLS certificate for serving HTTPS/WSS (see README "Create a local HTTPS certificate")
# Required: the server won't start without it, except on Colyseus Cloud (which terminates TLS
# itself, so leave these unset there) and in tests
# Paths are relative to the server folder
SSL_KEY_FILE=../certs/dev-key.pem
SSL_CERT_FILE=../certs/dev-cert.pem

# Origins allowed to use the server from a browser (CORS and WebSocket connections), comma-separated
# Required: the server won't start without it. Locally: the client, plus the server itself for the
# playground. In production: the client's real origin
ALLOWED_ORIGINS=https://www.multiversekiln-dev.com:5173,https://www.multiversekiln-dev.com:2567

# Postgres connection for the game server, as kiln_app (can read and write rows, can't alter tables)
# Locally: the Docker database, with KILN_APP_PASSWORD from the root .env. In production: Neon's pooled connection string
DATABASE_URL=postgres://kiln_app:replace-me@127.0.0.1:5432/kiln

# Postgres connection for npm run db:migrate, as kiln_migrator (owns the tables)
# Locally: KILN_MIGRATOR_PASSWORD from the root .env. Only migrations use it; never give it to the running server
MIGRATION_DATABASE_URL=postgres://kiln_migrator:replace-me@127.0.0.1:5432/kiln

# The same two connections for the test suite's database (npm test), which it empties before every test
# The database name must end in _test, or the tests refuse to run
TEST_DATABASE_URL=postgres://kiln_app:replace-me@127.0.0.1:5432/kiln_test
TEST_MIGRATION_DATABASE_URL=postgres://kiln_migrator:replace-me@127.0.0.1:5432/kiln_test

# Secret key for the keyed hashes stored in place of email addresses waiting on a code, the codes
# themselves, recovery codes and networks: at least 32 random bytes in base64 (see the top of this
# file). Changing it ends every email code waiting to be entered and resets the rate limits, which is
# harmless, but also stops every recovery code working, so players with two-factor authentication
# would need new ones
AUTH_HMAC_KEY=replace-me

# Secret key that encrypts the authenticator app secrets of accounts with two-factor authentication
# (AES-256-GCM): exactly 32 random bytes in base64 (see the top of this file). Keep it outside the
# database and its backups. Keep it as long as the database: changing it leaves every stored secret
# unreadable, so players with two-factor authentication could only log in with their recovery codes
TOTP_ENCRYPTION_KEY=replace-me

# Where the server sends email, as an SMTP URL, and the address emails come from (shown with the
# site's name). Locally: Mailpit in docker-compose.yml (it only answers on this machine, so plain SMTP;
# read the emails at http://127.0.0.1:8025). In production: a real SMTP service over TLS, e.g.
# smtps://user:password@host:465
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=no-reply@multiversekiln-dev.com

# The client's address: https://, with nothing after the host and port. Required: the server won't
# start without it. Emails link to its pages, and Google and Discord send players back to its login
# page, <SITE_URL>/login, which must be listed as a redirect URI in each provider's settings
SITE_URL=https://www.multiversekiln-dev.com:5173

# Logging in with Google and Discord: each is offered once both its client ID and secret are set, and
# left out while both are empty. Make a Google OAuth client (a web application) at
# https://console.cloud.google.com/apis/credentials, and a Discord application at
# https://discord.com/developers/applications (OAuth2 section), each with <SITE_URL>/login as its
# redirect URI. Use a separate client for each environment, and never commit a real secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# S3-compatible object storage for uploads such as tile graphics. Locally: the storage container in
# docker-compose.yml, with the keys from the root .env (it only answers on this machine, so plain HTTP,
# like Postgres). In production: any S3-compatible service (Cloudflare R2, AWS S3, Backblaze B2...),
# with a bucket made in its own tools, its endpoint (leave STORAGE_ENDPOINT unset for AWS S3), region,
# and keys that can read, write and delete in that bucket
STORAGE_ENDPOINT=http://127.0.0.1:8333
STORAGE_REGION=auto
STORAGE_BUCKET=kiln
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me

# Address buckets as https://endpoint/bucket rather than https://bucket.endpoint: true for SeaweedFS
STORAGE_FORCE_PATH_STYLE=true

# The test suite's bucket (npm test), on the same storage
TEST_STORAGE_BUCKET=kiln-test

# Server URL that npm run loadtest connects to (must match the certificate's hostname)
LOADTEST_ENDPOINT=wss://www.multiversekiln-dev.com:2567
