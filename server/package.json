{
	"private": true,
	"name": "server",
	"version": "0.1.0",
	"description": "Colyseus game server",
	"type": "module",
	"main": "build/index.js",
	"engines": {
		"node": ">= 22.22.1"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "node build/index.js",
		"loadtest": "tsx --env-file-if-exists=.env --use-system-ca loadtest/example.ts --room game --numClients 2",
		"build": "npm run clean && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"clean": "rimraf build",
		"test": "mocha -r tsx -r ./test/setup.ts \"test/**/*.test.ts\" --timeout 15000"
	},
	"author": "",
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@colyseus/loadtest": "^0.18.1",
		"@colyseus/sdk": "^0.18.1",
		"@colyseus/testing": "^0.18.5",
		"@types/express": "^5.0.6",
		"@types/mocha": "^10.0.1",
		"@types/node": "^24.19.2",
		"mocha": "^12.0.3",
		"rimraf": "^6.1.3",
		"tsx": "^4.21.0"
	},
	"dependencies": {
		"@colyseus/schema": "^5.0.14",
		"@colyseus/tools": "^0.18.1",
		"@multiverse-kiln/shared": "*",
		"colyseus": "^0.18.2",
		"express": "^5.2.1"
	}
}
