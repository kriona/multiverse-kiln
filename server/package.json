{
	"private": true,
	"name": "server",
	"version": "0.1.0",
	"description": "Colyseus game server",
	"type": "module",
	"main": "build/index.js",
	"engines": {
		"node": ">= 24.14.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "node build/index.js",
		"loadtest": "tsx --env-file-if-exists=.env --use-system-ca loadtest/example.ts --room session --numClients 2",
		"build": "npm run clean && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"clean": "rimraf build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
		"storage:setup": "tsx --env-file-if-exists=.env scripts/setupStorage.ts",
		"test": "mocha -r tsx -r ./test/setup.ts \"test/**/*.test.ts\" --timeout 15000"
	},
	"author": "",
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@colyseus/loadtest": "^0.18.1",
		"@colyseus/sdk": "^0.18.1",
		"@colyseus/testing": "^0.18.5",
		"@types/express": "^5.0.6",
		"@types/mocha": "^10.0.1",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"mocha": "^12.0.3",
		"rimraf": "^6.1.3",
		"tsx": "^4.21.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@colyseus/schema": "^5.0.42",
		"@colyseus/tools": "^0.18.10",
		"@multiverse-kiln/shared": "*",
		"colyseus": "^0.18.2",
		"drizzle-orm": "^0.45.4",
		"express": "^5.2.1",
		"pg": "^8.23.1",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	}
}
