# Hostname for the Vite dev server (must resolve to 127.0.0.1 via the hosts file; see README)
DEV_HOST=www.multiversekiln-dev.com

# Port for the Vite dev server
DEV_PORT=5173

# Local TLS certificate for the HTTPS dev server (required; see README "Create a local HTTPS certificate")
# Paths are relative to the client folder
DEV_SSL_KEY_FILE=../certs/dev-key.pem
DEV_SSL_CERT_FILE=../certs/dev-cert.pem

# Colyseus server WebSocket URL
# Use the same hostname as DEV_HOST so it matches the certificate
VITE_SERVER_URL=wss://www.multiversekiln-dev.com:2567

# Where players can the source code, linked from the page footer (required)
# The AGPL requires offering the source to players of a modified version, so a fork sets its own repository
VITE_SOURCE_URL=https://github.com/kriona/multiverse-kiln
