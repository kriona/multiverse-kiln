{
	"name": "@multiverse-kiln/shared",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
		"messages": "tsx scripts/messages.ts",
		"messages:check": "tsx scripts/messages.ts --check"
	},
	"dependencies": {
		"@colyseus/schema": "^5.0.39",
		"@formatjs/icu-messageformat-parser": "^3.5.21",
		"intl-messageformat": "^12.1.3"
	},
	"devDependencies": {
		"@types/node": "^25.9.9",
		"tsx": "^4.23.15"
	}
}
