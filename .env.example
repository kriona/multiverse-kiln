# Local Postgres in Docker (docker-compose.yml). Copy to .env and replace every placeholder
# Generate each password with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Hex passwords need no escaping in the connection strings in server/.env
# The passwords only take effect when the data volume is first created (see README "Start the database")

# Superuser password; only the container's setup script uses it
POSTGRES_PASSWORD=replace-me

# Password for kiln_migrator, the role drizzle-kit migrations run as (MIGRATION_DATABASE_URL in server/.env)
KILN_MIGRATOR_PASSWORD=replace-me

# Password for kiln_app, the role the game server runs as (DATABASE_URL in server/.env)
KILN_APP_PASSWORD=replace-me

# Host port for Postgres, bound to 127.0.0.1 only (default 5432)
POSTGRES_PORT=5432

# Keys for the local object storage (SeaweedFS's S3 API); the same two go in server/.env as
# STORAGE_ACCESS_KEY_ID and STORAGE_SECRET_ACCESS_KEY. Generate each like the passwords above
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me

# Host port for the storage's S3 API, bound to 127.0.0.1 only (default 8333)
STORAGE_PORT=8333

# Host ports for Mailpit, which catches the server's emails, bound to 127.0.0.1 only: SMTP (default
# 1025, SMTP_URL in server/.env) and the web inbox (default 8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
