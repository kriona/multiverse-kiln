* text=auto eol=crlf

# Shell scripts must be LF to run on Linux (Docker, CI, servers); Windows scripts must be CRLF
*.sh text eol=lf
.husky/** text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Dependabot edits package.json in a checkout made with these rules and commits it through GitHub's API,
# which stores it as-is, so a CRLF checkout would reach the repository
package.json text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.webp binary
*.mp3 binary
*.ogg binary
*.wav binary
